# Supabase — copy to .env.local and fill in from your Supabase project
# (Project Settings → API). Both are client-safe (public) values.
#
# When these are UNSET the app runs exactly like Phase 1: guest-only, no auth UI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Traffic Source analytics — the self-hosted tracker on Railway. Both values are
# public (they appear in the page HTML); neither is a secret. Set them on the
# SITE service, not the analytics service.
#
# SRC must be the tracker's full public URL ending in /t.js — it derives its
# collect endpoint from this. SITE_ID is the numeric id from the dashboard.
#
# When either is UNSET no script tag is emitted at all.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
