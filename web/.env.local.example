# Supabase — copy to .env.local and fill in from your Supabase project
# (Project Settings → API). Both are client-safe (public) values.
#
# When these are UNSET the app runs exactly like Phase 1: guest-only, no auth UI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics — self-hosted tracker (the Railway instance). Client-safe values.
# When NEXT_PUBLIC_ANALYTICS_SRC is UNSET no script tag is emitted at all.
#
# Umami:      SRC = https://<your-railway-app>.up.railway.app/script.js
#             plus NEXT_PUBLIC_ANALYTICS_WEBSITE_ID (the website's UUID,
#             Settings → Websites → Edit → Website ID)
# Plausible:  SRC = https://<your-railway-app>.up.railway.app/js/script.js
#             plus NEXT_PUBLIC_ANALYTICS_DOMAIN (the domain you added, e.g.
#             didtheyhockey.com)
#
# Set only the one your provider needs; leave the other blank.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
